# Keep locally-generated bytecode out of the build context.
#
# A regenerated .pyc changes the COPY layer's content hash and busts the build cache even
# when no source changed — and the image would ship bytecode that PYTHONDONTWRITEBYTECODE=1
# explicitly does not want.
__pycache__/
*.py[cod]

# Local virtualenvs and tooling caches, if an operator has run forge outside the image.
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
